# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-only key for bypassing RLS during server API operations (Never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Admin Authentication (Server-only, do NOT expose with NEXT_PUBLIC_)
ADMIN_EMAIL=admin@velora.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-random-session-signing-secret-key
